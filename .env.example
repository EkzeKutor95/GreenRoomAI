# Обязательные параметры iiko: заполните из своего подключения.
IIKO_BASE_URL=https://api-ru.iiko.services
IIKO_APP_ID=
IIKO_ORGANIZATION_ID=
IIKO_CLIENT_SECRET=
IIKO_API_KEY=

# Telegram: числовые ID. Для личного чата report ID должен входить в allowlist.
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USER_IDS=
TELEGRAM_REPORT_CHAT_ID=
IIKO_TIMEZONE=Europe/Moscow

# Один отчёт за завершённый учётный день; время в IIKO_TIMEZONE.
AUTO_REPORTS_ENABLED=false
DAILY_REPORTS_ENABLED=true
DAILY_REPORT_HOUR=1
OLAP_DELAY=30m
SHIFT_POLL_INTERVAL=5m
HTTP_TIMEOUT=60s
IIKO_REQUEST_INTERVAL=500ms
STATE_FILE=run/state.json
DESSERT_GROUPS=Десерты,Десерты из кухни
DESSERT_PRODUCT_IDS=

# Необязательно: вопросы к ИИ и распознавание фотографий.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_VISION_MODEL=gpt-4.1-mini

# Необязательно: локальный приём PersonalShift webhook.
WEBHOOK_LISTEN=
WEBHOOK_SECRET=
